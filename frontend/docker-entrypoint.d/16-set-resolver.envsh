# Sourced by the nginx entrypoint before envsubst runs on templates.
# Reads the first IPv4 nameserver from /etc/resolv.conf so nginx can
# re-resolve the upstream hostname dynamically instead of caching it at startup.
RESOLVER=$(awk '/^nameserver/ && $2 ~ /^[0-9]/{print $2; exit}' /etc/resolv.conf)
export RESOLVER
