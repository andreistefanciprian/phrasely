# ── Backend ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://phrasely:phrasely@localhost:5432/phrasely?sslmode=disable
PORT=8080
JWT_SECRET=change-me-to-a-long-random-secret
MAGIC_LINK_TTL=15m
JWT_TTL=720h
OAUTH_ACCESS_TOKEN_TTL=1h
# Frontend origin — magic links point here so users land on the verify page
BASE_URL=http://localhost:3000
# Leave blank to disable the curate endpoint
OPENAI_API_KEY=your-key-here
# Leave blank for local dev — magic links logged to stdout instead
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=noreply@getphrasely.com

# ── Frontend ──────────────────────────────────────────────────────────────────
# PORT=3000
# API_HOST=http://api:8080

# ── MCP ───────────────────────────────────────────────────────────────────────
# PORT=8081
# API_HOST=http://api:8080
# Public URLs used in OAuth 2.1 discovery documents — override with HTTPS URLs in prod
MCP_BASE_URL=http://localhost:8081
FRONTEND_BASE_URL=http://localhost:3000

# ── Phrase Digest worker ──────────────────────────────────────────────────────
# Uses DATABASE_URL, RESEND_API_KEY, and EMAIL_FROM from above.
# Runs as a Railway cron job (0 7 * * *). Locally: docker compose run --rm phrase-digest
# Leave RESEND_API_KEY blank to log digest emails to stdout instead of sending.

# ── All services ──────────────────────────────────────────────────────────────
# DEBUG, INFO (default), WARN, ERROR
LOG_LEVEL=DEBUG
