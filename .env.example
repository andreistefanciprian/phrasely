# Used when running the API locally with `go run` (db host = localhost)
DATABASE_URL=postgres://phrasely:phrasely@localhost:5432/phrasely?sslmode=disable
PORT=8080
OPENAI_API_KEY=your-key-here
# Used to verify/correct Merriam-Webster links returned by curate. Optional —
# if unset, curate links are returned as-is without verification.
MW_DICTIONARY_API_KEY=your-key-here
# BASE_URL is the frontend origin — magic links point here so users land on the verify page
BASE_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-secret
# How long a magic link token is valid for before it expires (Go duration format)
MAGIC_LINK_TTL=15m
# How long an issued JWT is valid for (Go duration format)
JWT_TTL=720h
# Email — leave blank for local dev (magic link logged to stdout)
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=noreply@getphrasely.com

# Frontend nginx — internal API address
# Local dev: http://api:8080
# Railway:   http://api.railway.internal:8080
API_HOST=http://api:8080
