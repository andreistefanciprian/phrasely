# Used when running the API locally with `go run` (db host = localhost)
DATABASE_URL=postgres://phrasely:phrasely@localhost:5432/phrasely?sslmode=disable
PORT=8080
OPENAI_API_KEY=your-key-here
BASE_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-secret

# Frontend nginx — internal API address
# Local dev: http://api:8080
# Railway:   http://api.railway.internal:8080
API_HOST=http://api:8080
